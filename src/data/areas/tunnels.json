    "biscuit": [
      {
        "do": [
          {
            "say": [
              [
                "NARRATOR",
                "Across the flooded pipe, an orange cat sits on a rusty sprinkler valve. He looks bored."
              ],
              [
                "NARRATOR",
                "A Vole Lieutenant stands guard over him, holding a tiny clipboard."
              ],
              [
                "DAD",
                "Is that... are you holding that cat hostage?"
              ]
            ]
          },
          {
            "battle": "vole-lieutenant",
            "victory": [
              {
                "set": {
                  "foundBiscuit": true
                }
              },
              {
                "say": [
                  [
                    "NARRATOR",
                    "The Vole Lieutenant retreats into the wall to file a report."
                  ],
                  [
                    "NARRATOR",
                    "The cat walks over and sits on Dad's foot. His collar says BISCUIT."
                  ],
                  [
                    "DAD'S BRAIN",
                    "Mrs. Okafor. Next door. Bring him up."
                  ]
                ]
              },
              {
                "save": true
              }
            ],
            "escape": [
              {
                "say": [
                  [
                    "NARRATOR",
                    "Dad backs away. The vole writes something down."
                  ]
                ]
              }
            ]
          }
        ]
      }
    ],
    "moleking": [
      {
        "when": {
          "flags": [
            "moleKingDefeated"
          ]
        },
        "do": [
          {
            "say": [
              [
                "NARRATOR",
                "An empty throne of lawn ornaments. A small crown lies on the floor."
              ],
              [
                "NARRATOR",
                "Dad leaves it. It's not his size."
              ]
            ]
          }
        ]
      },
      {
        "when": {
          "not": {
            "flags": [
              "burrowPlugged1",
              "burrowPlugged2",
              "burrowPlugged3"
            ]
          }
        },
        "do": [
          {
            "say": [
              [
                "NARRATOR",
                "On a throne of stolen lawn ornaments sits a mole in a crown."
              ],
              [
                "THE MOLE KING",
                "A visitor. With a shovel. How quaint."
              ],
              [
                "NARRATOR",
                "Before Dad can move, the Mole King drops into a burrow and is gone."
              ],
              [
                "DAD'S BRAIN",
                "He has escape burrows. Plug all 3 and he can't run."
              ]
            ]
          },
          {
            "if": {
              "step": "defeat-mole-king"
            },
            "then": [
              {
                "step": "plug-burrows"
              }
            ]
          }
        ]
      },
      {
        "do": [
          {
            "say": [
              [
                "NARRATOR",
                "The Mole King sits on his throne of stolen lawn ornaments. He turns his face toward Dad. He has no eyes to speak of."
              ],
              [
                "THE MOLE KING",
                "You plugged my burrows. You walked my halls. You sweat on my floor."
              ],
              [
                "THE MOLE KING",
                "Very well. Let us settle this, lawn man. For the lawn."
              ],
              [
                "DAD",
                "For the lawn."
              ]
            ]
          },
          {
            "if": {
              "flags": [
                "hasCastorOil"
              ]
            },
            "then": [
              {
                "say": [
                  [
                    "NARRATOR",
                    "Dad throws a handful of castor oil pellets on the floor."
                  ]
                ]
              }
            ]
          },
          {
            "battle": "mole-king",
            "victory": [
              {
                "set": {
                  "moleKingDefeated": true
                }
              },
              {
                "complete": "defeat-mole-king"
              },
              {
                "step": "return-to-wife-lawn"
              },
              {
                "say": [
                  [
                    "NARRATOR",
                    "The Mole King sinks into the soil for the last time. His crown rolls to Dad's feet."
                  ],
                  [
                    "THE MOLE KING",
                    "Fine. FINE. We will move to the Hendersons'. They have a pool."
                  ],
                  [
                    "NARRATOR",
                    "Far above, every molehill in the yard sinks flat at once."
                  ],
                  {
                    "speaker": "DAD",
                    "voice": "dad:selfTalk:victory"
                  }
                ]
              },
              {
                "save": true
              },
              {
                "goto": "BackyardScene",
                "spawn": "tunnels"
              }
            ]
          }
        ]
      }
