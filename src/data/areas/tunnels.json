        "do": [
          {
            "say": [
              [
                "NARRATOR",
                "An escape burrow. It goes up to the lawn, under the patio."
              ],
              [
                "NARRATOR",
                "Dad tries to fill it with his hands. The dirt goes right back in."
              ],
              [
                "DAD'S BRAIN",
                "We need a real shovel. Dome Hepot. Garden aisle."
              ]
            ]
          }
        ]
      },
      {
        "do": [
          {
            "set": {
              "burrowPlugged1": true
            }
          },
          {
            "say": [
              [
                "NARRATOR",
                "An escape burrow, under the patio."
              ],
              [
                "NARRATOR",
                "Dad packs it with dirt using the Flat-Edge Spade, then stomps it flat."
              ],
              [
                "DAD",
                "Not today, your majesty."
              ]
            ]
          },
          {
            "if": {
              "flags": [
                "burrowPlugged1",
                "burrowPlugged2",
                "burrowPlugged3"
              ]
            },
            "then": [
              {
                "if": {
                  "step": "plug-burrows"
                },
                "then": [
                  {
                    "complete": "plug-burrows"
                  },
                  {
                    "step": "defeat-mole-king"
