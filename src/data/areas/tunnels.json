          {
            "say": [
              [
                "NARRATOR",
                "Dad climbs down an old wooden ladder into the dark."
              ],
              [
                "NARRATOR",
                "The tunnels go on much further than any lawn should allow."
              ],
              [
                "DAD'S BRAIN",
                "The deeper we go, the worse it gets. Classic underground. Grind up top first."
              ]
            ]
          },
          {
            "save": true
          }
        ]
      },
      {
        "do": [
          {
            "say": [
              [
                "NARRATOR",
                "Cool, damp dirt. The smell of every spring Dad has ever had."
