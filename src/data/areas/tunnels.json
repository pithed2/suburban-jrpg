                ]
              },
              {
                "say": [
                  [
                    "SYSTEM",
                    "All 3 escape burrows are plugged."
                  ],
                  [
                    "DAD'S BRAIN",
                    "He has nowhere to run. The throne room. Deep down. Go."
                  ]
                ]
              }
            ],
            "else": [
              {
                "say": [
                  [
                    "SYSTEM",
                    "Dad plugged an escape burrow."
                  ]
                ]
