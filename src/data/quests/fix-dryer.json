      "id": "find-wrench",
      "label": "Find the wrench"
    },
    {
      "id": "flip-breaker",
      "label": "Flip the breaker"
    },
    {
      "id": "defeat-heating-coil",
      "label": "Defeat Evil Heating Coil"
    },
    {
      "id": "restore-power",
      "label": "Restore power"
    },
    {
      "id": "return-to-wife",
      "label": "Return to wife"
    }
  ],
  "defeat": {
    "lines": [
      [
        "WIFE",
        "Why are you in the chair? The dryer is still broken."
      ]
    ],
    "hints": [
      {
        "when": {
          "notFlags": [
            "foundWrench"
          ]
        },
        "text": "New plan: find the wrench, then worry about appliance combat."
      },
      {
        "when": {
          "notFlags": [
            "circuitBreakerOff"
          ]
        },
        "text": "New plan: keep the wrench, turn off the breaker, then try heroics again."
      },
      {
        "text": "New plan: breaker stayed off. Heal up, keep the wrench, and go finish this."
      }
    ]
  },
  "events": {
    "house:wife": [
      {
        "when": {
          "flags": [
            "dryerFixed"
          ]
        },
        "do": [
          {
            "say": [
              [
                "WIFE",
                "The dryer is still working. I am choosing to believe this is permanent."
              ],
              [
                "DAD",
                "That's wise. Also brave."
              ]
            ]
          },
          {
            "checkIn": true
          }
        ]
      },
      {
        "when": {
          "flags": [
            "bossDefeated",
            "circuitBreakerOff"
          ]
        },
        "do": [
          {
            "step": "restore-power"
          },
          {
            "hud": "POWER OUT"
          },
          {
            "say": [
              [
                "WIFE",
                "Now, nothing works! What did you do??"
              ],
              [
                "DAD'S BRAIN",
                "Dude. Dryers don't work without power."
              ],
              [
                "DAD",
                "Small administrative follow-up. Totally under control."
              ],
              [
                "NARRATOR",
                "The basement breaker waits for Dad's victory lap."
              ]
            ]
          },
          {
            "checkIn": true
          }
        ]
      },
      {
        "when": {
          "flags": [
            "bossDefeated"
          ]
        },
        "do": [
          {
            "complete": "return-to-wife"
          },
          {
            "set": {
              "dryerFixed": true
            }
          },
          {
            "hud": "DRYER FIXED"
          },
          {
            "save": true
          },
          {
            "say": [
              {
                "speaker": "DAD",
                "voice": "dad:toWife:greeting"
              },
              [
                "WIFE",
                "You fixed it? The towels are actually dry?"
              ],
              {
                "narrate": "victory"
              },
              [
                "DAD",
                "What can I say? The Dad shows up, identifies the problem, defeats the problem, and restores domestic order."
              ],
              [
                "WIFE",
                "It only took you one garage expedition, one basement expedition, and a full appliance duel."
              ],
              [
                "DAD",
                "That's called commitment. Also, I got a pretty good arm workout in. Honestly? Feeling a little swole."
              ],
              [
                "DAD",
                "You should feel these arms right now. Big flex."
              ],
              [
                "WIFE",
                "Aw. Look at you."
              ],
              [
                "WIFE",
                "You wish. Your to-do list is way too long."
              ],
              [
                "WIFE",
                "Thank you. Sincerely. I will be impressed for at least the next ninety seconds."
              ],
              [
                "KID",
                "Hey Dad, the toilet is doing that thing again."
              ],
              [
                "DAD",
                "That's not vague at all."
              ],
              [
                "WIFE",
                "Now... about the upstairs toilet."
              ],
              [
                "DAD",
                "..."
              ],
              [
                "WIFE",
                "It's been making that sound again."
              ],
              [
                "DAD'S BRAIN",
                "There is always another sound."
              ],
              [
                "DAD",
                "I handled a live heating coil today. The toilet doesn't scare me."
              ],
              [
                "WIFE",
                "It should."
              ],
              [
                "NARRATOR",
                "The Dad's brief moment of peace ends. Upstairs, something gurgles."
              ],
              [
                "DAD'S BRAIN",
                "One disaster at a time. That's the code."
              ]
            ]
          },
          {
            "checkIn": true
          },
          {
            "say": [
              {
                "speaker": "DAD",
                "voice": "dad:selfTalk:victory"
              }
            ]
          },
          {
            "completeQuest": "fix-dryer"
          },
          {
            "startQuest": "fix-bathroom"
          },
          {
            "complete": "talk-to-wife-bathroom"
          },
          {
            "step": "visit-home-depot"
          },
          {
            "save": true
          }
        ]
      },
      {
        "do": [
          {
            "say": [
              {
                "speaker": "DAD'S BRAIN",
                "voice": "brain:talkToWife"
              },
              {
                "speaker": "DAD",
                "voice": "dad:toWife:greeting"
              },
              [
                "WIFE",
                "How's the dryer coming?"
              ],
              {
                "speaker": "DAD",
                "voice": "dad:toWife:questReceived"
              }
            ]
          },
          {
            "checkIn": true
          }
        ]
      }
    ]
  }
}